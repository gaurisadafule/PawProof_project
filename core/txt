# --- 1. SINGLE TRANSIT ALLOCATION (LOAD-BALANCED) ---
def assign_least_busy_transit(ward_name):
    conn = get_connection()
    cursor = conn.cursor(dictionary=True)

    cursor.execute("SELECT username FROM system_users WHERE role = 'TRANSIT' AND ward = %s", (ward_name,))
    drivers = cursor.fetchall()

    if not drivers:
        cursor.close()
        conn.close()
        return None

    driver_list = [d["username"] for d in drivers]
    placeholders = ','.join(['%s'] * len(driver_list))
    query = f"""
        SELECT assigned_transit, COUNT(*) as active_count 
        FROM intake_requests 
        WHERE assigned_transit IN ({placeholders}) AND status = 'PENDING_PICKUP'
        GROUP BY assigned_transit
    """
    cursor.execute(query, tuple(driver_list))
    counts = {row["assigned_transit"]: row["active_count"] for row in cursor.fetchall()}
    cursor.close()
    conn.close()

    return min(driver_list, key=lambda d: counts.get(d, 0))

def insert_citizen_request(ward, landmark, lat, lng, image_path, embedding_list, reported_by):
    assigned_van = assign_least_busy_transit(ward)

    conn = get_connection()
    cursor = conn.cursor()
    emb_bytes = np.array(embedding_list, dtype=np.float32).tobytes()
    sql = """
        INSERT INTO intake_requests (ward, landmark, lat, lng, image_path, embedding, reported_by, assigned_transit, status)
        VALUES (%s, %s, %s, %s, %s, %s, %s, %s, 'PENDING_PICKUP')
    """
    cursor.execute(sql, (ward, landmark, lat, lng, image_path, emb_bytes, reported_by, assigned_van))
    conn.commit()
    cursor.close()
    conn.close()
    return assigned_van

