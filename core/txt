def assign_ward_vet(ward_name):
    conn = get_connection()
    cursor = conn.cursor(dictionary=True)

    cursor.execute("SELECT username FROM system_users WHERE role = 'VET_OFFICE' AND ward = %s", (ward_name,))
    vets = cursor.fetchall()

    if not vets:
        cursor.execute("SELECT username FROM system_users WHERE role = 'VET_OFFICE' LIMIT 1")
        vets = cursor.fetchall()

    if not vets:
        cursor.close()
        conn.close()
        return None

    vet_list = [v["username"] for v in vets]
    placeholders = ','.join(['%s'] * len(vet_list))
    query = f"""
        SELECT assigned_vet, COUNT(*) as caseload 
        FROM canine_registry 
        WHERE assigned_vet IN ({placeholders}) AND status = 'CAPTURED_IN_TRANSIT'
        GROUP BY assigned_vet
    """
    cursor.execute(query, tuple(vet_list))
    counts = {row["assigned_vet"]: row["caseload"] for row in cursor.fetchall()}
    cursor.close()
    conn.close()

    return min(vet_list, key=lambda v: counts.get(v, 0))

